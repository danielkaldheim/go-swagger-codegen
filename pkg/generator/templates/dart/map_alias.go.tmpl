{{define "map_alias"}}class {{.Classname}} {
  final Map<String, {{.DataType}}> data;

  {{.Classname}}({Map<String, {{.DataType}}>? data})
      : data = data != null ? Map<String, {{.DataType}}>.from(data) : {};

  @override
  String toString() {
    return '{{.Classname}}[data=$data]';
  }

  /// Each value is converted, not cast. `Map.from` only re-types the map, so
  /// for a map of models it hands back the raw decoded maps and blows up on
  /// first use with "_Map<String, dynamic> is not a subtype of ...".
  factory {{.Classname}}.fromJson(dynamic json) {
    if (json == null || json is! Map) {
      return {{.Classname}}();
    }
    return {{.Classname}}(
      data: json.map<String, {{.DataType}}>(
        (key, value) => MapEntry(key.toString(), {{elementFromJson .DataType "value"}}),
      ),
    );
  }

  Map<String, {{.DataType}}> toJson() => data;

  /// Returns a copy with one entry set, or removed when [value] is null.
  /// Free-form maps are edited far more often than they are replaced.
  {{.Classname}} copyWithEntry(String key, {{.DataType}}? value) {
    final next = Map<String, {{.DataType}}>.from(data);
    if (value == null) {
      next.remove(key);
    } else {
      next[key] = value;
    }
    return {{.Classname}}(data: next);
  }

  static List<{{.Classname}}> listFromJson(List<dynamic> json) {
    return json.isEmpty ? [] : json.map((value) => {{.Classname}}.fromJson(value)).toList();
  }

  static Map<String, {{.Classname}}> mapFromJson(Map<String, dynamic> json) {
    var map = <String, {{.Classname}}>{};
    json.forEach((String key, dynamic value) => map[key] = {{.Classname}}.fromJson(value));
    return map;
  }
}
{{end}}
