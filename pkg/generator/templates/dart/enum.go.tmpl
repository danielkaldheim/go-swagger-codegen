{{define "enum"}}class {{.Classname}} {
  /// The underlying value of this enum member.
  {{.DataType}} value;

  {{.Classname}}._internal(this.value);

  {{if .AllowableValues}}
    {{range .AllowableValues.EnumVars}}
      {{if .Description}}
  /// {{.Description}}
      {{end}}
  static {{$.Classname}} {{.Name}} = {{$.Classname}}._internal({{.Value}});
    {{end}}
  {{end}}

  {{.Classname}}.fromJson(dynamic data) {
    switch (data) {
    {{if .AllowableValues}}
      {{range .AllowableValues.EnumVars}}
          case {{.Value}}: value = data; break;
      {{end}}
    {{end}}
    default: throw('Unknown enum value to decode: $data');
    }
  }

  static dynamic encode({{.Classname}} data) {
    return data.value;
  }

  /// Lets `json.encode` reach this type. `encode` above is static, so it only
  /// helps a caller that already knows the concrete type; anything generic — a
  /// request body carrying this field, or a cache writing the whole model —
  /// needs an instance `toJson()` or it throws
  /// "Converting object to an encodable object failed".
  {{.DataType}} toJson() {
    return value;
  }
}
{{end}}
