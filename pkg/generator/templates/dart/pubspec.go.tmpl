name: {{.PubName}}
version: {{.PubVersion}}
description: {{.PubDescription}}
publish_to: none

dependencies:
  http: ">=1.2.2"
  riverpod: '>=3.2.1 <4.0.0'
  flutter_riverpod: '>=3.2.1 <4.0.0'
{{- if .CrudusCommonPath}}
  crudus_common:
    path: {{.CrudusCommonPath}}
{{- else}}
  crudus_common: '>=1.0.0'
{{- end}}
dev_dependencies:
  flutter_lints: '>=5.0.0'
  test: '>=1.3.0 <2.0.0'
environment:
  sdk: ">=3.0.0 <4.0.0"
